<%- include('../partials/header', { bare: true }) %>
<div class="loginwrap">
  <section class="loginhero">
    <div class="brandline"><svg class="ic logo"><use href="#i-logo"/></svg><b><%= appName %></b></div>
    <h1>One place for every request.</h1>
    <p>Log incidents and requests, follow your service levels, and keep contracts, tenders and the sales pipeline in one workspace.</p>
    <svg class="wave" viewBox="0 0 800 160" preserveAspectRatio="none" aria-hidden="true"><path d="M0 160V90C120 40 220 130 360 100 500 70 620 10 800 50V160z"/></svg>
  </section>
  <section class="loginform">
    <div class="card">
      <h1>Sign in</h1>
      <% if (error) { %><p class="error"><%= error %></p><% } %>
      <form method="post" action="/login">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="next" value="<%= next %>">
        <p><label for="email">Email address or user name</label><input id="email" name="email" type="text" maxlength="254" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus></p>
        <p><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required></p>
        <button class="btn" type="submit">Sign in</button>
      </form>
      <p class="hint">Forgotten your password? Ask your service desk administrator to reset it.</p>
    </div>
  </section>
</div>
<%- include('../partials/footer', { bare: true }) %>
