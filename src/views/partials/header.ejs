<!doctype html>
<html lang="en" data-theme="<%= typeof theme !== 'undefined' && theme ? theme : 'default' %>"<%- typeof navCollapsed !== 'undefined' && navCollapsed ? ' data-nav="collapsed"' : '' %>>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% var B = (typeof brand !== 'undefined' && brand) || { name: '', displayName: appName, logo: null }; var logoSrc = B.logo ? '/branding/logo?v=' + B.logo.sha.slice(0, 12) : ''; %>
<title><%= title ? title + ' · ' : '' %><%= B.displayName %></title>
<link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
<link rel="stylesheet" href="/static/app.css?v=<%= appVersion %>">
<script src="/static/app.js?v=<%= appVersion %>" defer></script>
</head>
<% var isBare = typeof bare !== 'undefined' && bare; var groups = (typeof nav !== 'undefined' && nav) || []; %>
<% if (isBare) { %>
<body class="plain">
<%- include('icons') %>
<% } else if (!user) { %>
<body class="public">
<%- include('icons') %>
<header class="pubbrand<%= logoSrc ? ' has-logo' : '' %>"><% if (logoSrc) { %><b><%= appName %></b><img class="brandlogo<%= B.recolor ? ' tint' : '' %>" src="<%= logoSrc %>" alt="<%= B.displayName %>"><% } else { %><svg class="ic logo" aria-hidden="true"><use href="#i-logo"/></svg><b><%= B.displayName %></b><% } %></header>
<main class="content">
<% } else { %>
<body<%- typeof idleSeconds !== 'undefined' && idleSeconds ? ' data-idle="' + Number(idleSeconds) + '"' : '' %>>
<%- include('icons') %>
<div class="shell">
  <aside class="sidebar">
    <a class="brandblock<%= logoSrc ? ' has-logo' : '' %>" href="<%= user.kind === 'customer' ? '/portal' : '/' %>">
      <% if (logoSrc) { %><b class="prodname"><%= appName %></b><span class="logotile"><img class="brandlogo<%= B.recolor ? ' tint' : '' %>" src="<%= logoSrc %>" alt="<%= B.displayName %>"></span><% } else { %><svg class="ic logo"><use href="#i-logo"/></svg>
      <b><%= B.displayName %><% if (B.name) { %><small class="brandsub"><%= appName %></small><% } %></b><% } %>
      <span class="motif" aria-hidden="true"><i class="sq m1"></i><i class="sq m2"></i><i class="sq m3"></i><i class="sq m4"></i></span>
    </a>
    <nav class="sidenav" aria-label="Main">
      <% groups.forEach(function (g, gi) { var gid = 'navg-' + (g.id || gi); %>
        <% if (g.title) { %><div class="navgroup<%= g.open ? '' : ' folded' %>" data-navgroup="<%= g.id %>">
          <button type="button" class="navhead" aria-expanded="<%= g.open ? 'true' : 'false' %>" aria-controls="<%= gid %>"><span><%= g.title %></span><% if (g.badge) { %><span class="badge sum"><%= g.badge %></span><% } %><svg class="ic chev" aria-hidden="true"><use href="#i-chevron"/></svg></button>
          <div class="navitems" id="<%= gid %>"><% } else { %><div class="navgroup plain"><div class="navitems"><% } %>
        <% g.forEach(function (it) { %><a href="<%= it.href %>" class="<%= it.on ? 'on' : '' %>" title="<%= it.label %>"<%- it.on ? ' aria-current="page"' : '' %>><svg class="ic"><use href="#i-<%= it.icon %>"/></svg><span><%= it.label %></span><% if (it.badge) { %><span class="badge"><%= it.badge %></span><% } %></a><% }) %>
        </div></div>
      <% }) %>
    </nav>
    <div class="sidefoot" aria-hidden="true">
      <span class="motif"><i class="sq f1"></i><i class="sq f2"></i><i class="sq f3"></i><i class="sq f4"></i><i class="sq f5"></i><i class="sq f6"></i><i class="sq f7"></i></span>
      <small><%= appName %> <%= appVersion %></small>
    </div>
  </aside>
  <div class="main">
    <header class="topbar">
      <button type="button" class="iconbtn navtoggle" data-nav-toggle aria-label="Collapse or expand the menu" aria-expanded="<%= typeof navCollapsed !== 'undefined' && navCollapsed ? 'false' : 'true' %>" title="Collapse or expand the menu"><svg class="ic"><use href="#i-menu"/></svg></button>
      <div class="welcome"><b>Welcome, <%= String(user.name || '').split(' ')[0] %></b><span><%= B.displayName %><%= user.customer_name ? ' · ' + user.customer_name : '' %></span></div>
      <form class="search" method="get" action="/search" role="search">
        <svg class="ic"><use href="#i-search"/></svg>
        <input type="search" name="q" placeholder="<%= user.kind === 'customer' ? 'Search your tickets and help articles…' : 'Search tickets, customers and more…' %>" aria-label="Search" maxlength="100">
      </form>
      <div class="tools">
        <details class="pop themeswitch">
          <summary class="iconbtn" aria-label="Change theme" title="Change theme"><svg class="ic"><use href="#i-palette"/></svg></summary>
          <div class="menu">
            <p><b>Theme</b></p>
            <form method="post" action="/account/theme">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="<%= typeof currentUrl !== 'undefined' ? currentUrl : '/' %>">
              <% (typeof themes !== 'undefined' ? themes : []).forEach(function (t) { %><button type="submit" name="theme" value="<%= t.id %>" class="themeopt<%= t.id === theme ? ' on' : '' %>"<%- t.id === theme ? ' aria-current="true"' : '' %>><span class="sw t-<%= t.id %>"></span><span class="tl"><b><%= t.label %></b><small><%= t.text %></small></span><% if (t.id === theme) { %><svg class="ic tick"><use href="#i-check"/></svg><% } %></button><% }) %>
            </form>
          </div>
        </details>
        <details class="pop">
          <summary class="iconbtn" aria-label="Notifications"><svg class="ic"><use href="#i-bell"/></svg><% if (alerts && alerts.count) { %><span class="dot"></span><% } %></summary>
          <div class="menu">
            <% if (alerts && alerts.items.length) { %><% alerts.items.forEach(function (a) { %><a href="<%= a.href %>"><%= a.text %></a><% }) %><% } else { %><p>Nothing needs your attention.</p><% } %>
          </div>
        </details>
        <a class="iconbtn" href="/manual" target="_blank" rel="noopener" aria-label="User Manual (opens in a new tab)" title="User Manual"><svg class="ic"><use href="#i-help"/></svg></a>
        <details class="pop usermenu">
          <summary><span class="avatar"><%= String(user.name || '?').split(/\s+/).filter(Boolean).slice(0, 2).map(function (w) { return w[0]; }).join('').toUpperCase() %></span><span class="uname"><%= user.name %></span></summary>
          <div class="menu">
            <p><%= user.email %><br><%= roleLabels[user.role] %></p>
            <a href="/account">My account</a>
            <% if (typeof adminLinks !== 'undefined' && adminLinks) { %><a href="/admin">Administration</a><% } %>
            <hr>
            <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Sign out</button></form>
          </div>
        </details>
      </div>
    </header>
    <main class="content">
<% } %>
<% if (!isBare && typeof serviceNotices !== 'undefined' && serviceNotices && serviceNotices.length) { %><div class="noticebar" role="status"><% serviceNotices.slice(0, 3).forEach(function (n) { %>
  <a class="notice <%= n.kind === 'incident' ? (n.severity === 'outage' ? 'outage' : 'degraded') : 'maint' %>" href="/portal/status#n<%= n.id %>"><b><%= n.kind === 'incident' ? 'Service incident' : (n.status === 'in_progress' ? 'Maintenance in progress' : 'Planned maintenance') %>:</b> <%= n.title %><% if (n.kind === 'maintenance' && n.status !== 'in_progress') { %> <span>(<%= fmt.dt(n.starts_at) %>)</span><% } %> <span class="more">Details</span></a>
<% }) %></div><% } %>
<% if (!isBare && typeof majorIncidents !== 'undefined' && majorIncidents && majorIncidents.length) { %><div class="noticebar" role="status"><% majorIncidents.slice(0, 3).forEach(function (n) { %>
  <a class="notice <%= n.severity === 'outage' ? 'outage' : 'degraded' %>" href="/notices/<%= n.id %>"><b>Major incident <%= n.ref %>:</b> <%= n.title %> <span>(<%= ({ investigating: 'investigating', identified: 'cause identified', monitoring: 'fixed, monitoring' })[n.status] || n.status %>)</span> <span class="more">Open</span></a>
<% }) %></div><% } %>
<% if (!isBare && flash && flash.length) { %><ul class="messages"><% flash.forEach(function (m) { %><li class="<%= m.type %>"><%= m.msg %></li><% }) %></ul><% } %>
