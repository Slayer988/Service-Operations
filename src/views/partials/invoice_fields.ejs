<%# Invoice header form. form; contracts, projects, currencies; fixedCustomer (the customer is set) %>
<div class="grid2">
<p><label for="if_title">For (what is billed)</label><input id="if_title" name="title" maxlength="200" value="<%= form.title || '' %>" placeholder="e.g. Managed network services, November 2026"><small>Filled in from what you bill if you leave it empty.</small></p>
<p><label for="if_ref">Customer's order number</label><input id="if_ref" name="customer_ref" maxlength="120" value="<%= form.customer_ref || '' %>"></p>
<p><label for="if_contract">Contract</label><select id="if_contract" name="contract_id"><option value="">—</option>
<% contracts.forEach(function (c) { %><option value="<%= c.id %>" <%= String(form.contract_id) === String(c.id) ? 'selected' : '' %>><%= c.reference %> · <%= c.title %></option><% }) %></select></p>
<p><label for="if_project">Project</label><select id="if_project" name="project_id"><option value="">—</option>
<% projects.forEach(function (p) { %><option value="<%= p.id %>" <%= String(form.project_id) === String(p.id) ? 'selected' : '' %>><%= p.ref %> · <%= p.name %></option><% }) %></select><small>Counted as billed in the project's budget against actual.</small></p>
<p><label for="if_cur">Currency</label><select id="if_cur" name="currency"><% currencies.forEach(function (c) { %><option <%= form.currency === c ? 'selected' : '' %>><%= c %></option><% }) %></select></p>
<p><label for="if_tax">Tax</label><span class="rowform"><input name="tax_label" maxlength="20" value="<%= form.tax_label || 'VAT' %>" aria-label="Tax name" class="num"> <input id="if_tax" name="tax_rate" inputmode="decimal" value="<%= form.tax_rate %>" aria-label="Tax rate in percent" class="num"> %</span></p>
<p><label for="if_date">Invoice date</label><input id="if_date" name="issue_date" type="date" value="<%= form.issue_date ? String(form.issue_date).slice(0, 10) : '' %>"><small>Set to the day it is issued.</small></p>
<p><label for="if_due">Due date</label><input id="if_due" name="due_date" type="date" value="<%= form.due_date ? String(form.due_date).slice(0, 10) : '' %>"></p>
<p><label for="if_from">Period from</label><input id="if_from" name="period_from" type="date" value="<%= form.period_from ? String(form.period_from).slice(0, 10) : '' %>"></p>
<p><label for="if_to">Period to</label><input id="if_to" name="period_to" type="date" value="<%= form.period_to ? String(form.period_to).slice(0, 10) : '' %>"></p>
</div>
<p><label for="if_pay">Payment terms</label><input id="if_pay" name="payment_terms" maxlength="500" value="<%= form.payment_terms || '' %>"></p>
<p><label for="if_terms">Terms <small class="muted">(printed on the invoice)</small></label><textarea id="if_terms" name="terms" rows="2" maxlength="4000"><%= form.terms || '' %></textarea></p>
<p><label for="if_notes">Internal notes <small class="muted">(never printed)</small></label><textarea id="if_notes" name="internal_notes" rows="2" maxlength="4000"><%= form.internal_notes || '' %></textarea></p>
