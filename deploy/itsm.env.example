# /etc/itsm/itsm.env  -- read by systemd (web + worker) and the maintenance scripts.
# One KEY=value per line. No quotes, no spaces around "=".  Keep this file private (root:itsm, mode 640).

NODE_ENV=production
BASE_URL=https://services.example.com
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=1
APP_TIMEZONE=Africa/Nairobi

# Generated by install.sh. Never share it or put it in source control.
SESSION_SECRET=change-me

# PostgreSQL over the local unix socket (peer authentication: no database password exists).
PGHOST=/var/run/postgresql
PGUSER=itsm
PGDATABASE=itsm

STORAGE_DIR=/var/lib/itsm/storage

# Outgoing e-mail (notifications, acknowledgements, renewal reminders).
# Leave SMTP_HOST empty to write e-mails to the log instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Service Operations (Ops) <ops@example.com>"

# Display name shown in the browser, the header and e-mails.
APP_NAME="Service Operations (Ops)"

# Credentials for the shared mailboxes (up to five). You choose the variable NAMES on the E-mail page; the values live only here.
#   IMAP:               the mailbox password
#   Microsoft 365:      the client secret of the Entra ID app registration
#   Google Workspace:   the PATH of the service-account JSON key file (root:itsm, mode 640)
MAILBOX_SECURITY_PASSWORD=
MAILBOX_SERVICES_PASSWORD=
M365_CLIENT_SECRET=
GOOGLE_SA_KEY_FILE=/etc/itsm/google-sa.json

# Behind a corporate proxy? Microsoft 365 and Google are reached over HTTPS from the worker. Recent Node 22/24 releases honour:
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.corp.local:3128

# Active Directory is set up on Administration -> User management (the service account password is typed there and stored encrypted).
# Only needed if you would rather keep the password in this file; a saved password on that page takes precedence.
LDAP_BIND_PASSWORD=

# Optional malware scanner run on every uploaded file; exit code 1 = infected. Leave empty if none is installed.
# Example (needs the clamav package): AV_COMMAND=clamscan --no-summary
AV_COMMAND=

LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
SESSION_IDLE_HOURS=8
